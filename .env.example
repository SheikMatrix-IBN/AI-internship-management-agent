# Copy this file to .env and replace placeholders.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.5
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral

# Local development:
DATABASE_URL=sqlite:///./internship.db

# Production PostgreSQL example (URL-encode special characters in password):
# DATABASE_URL=postgresql+psycopg://internship_user:password@localhost:5432/internship_ai

# Set only if you implement authenticated login:
APP_ADMIN_EMAIL=admin@example.com
